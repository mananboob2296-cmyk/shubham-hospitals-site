---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import VideoStrip from '../../components/VideoStrip.astro';
import { latest } from '../../lib/videos';
import { videoStrings } from '../../i18n/videos';
import { procContent } from '../../i18n/procedures';

export async function getStaticPaths() {
  const treatments = await getCollection('treatments');
  return treatments
    .filter((t) => !t.slug.includes('/')) // English entries live at the collection root
    .map((t) => ({ params: { slug: t.slug }, props: { entry: t } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const vs = videoStrings.en;
const relatedVideos = entry.slug === 'advanced-laparoscopy-hysteroscopy' ? latest('drManan', 3) : [];

// Procedure pages sit under /procedures/, not /departments/ — the collection is
// shared, so the parent is decided by `kind` (see src/i18n/procedures.ts).
const p = procContent.en;
const isProcedure = entry.data.kind === 'procedure';
const eyebrow = isProcedure ? p.singleEyebrow : 'Department';
const parent = isProcedure
  ? { label: p.crumbProcedures, href: '/procedures/' }
  : { label: 'Departments', href: '/departments/' };
const crumbs = [{ label: 'Home', href: '/' }, parent, { label: entry.data.title }];
---
<BaseLayout title={entry.data.metaTitle} description={entry.data.metaDescription}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.excerpt}</p>
      <div class="btn-row">
        <a class="btn btn-primary" style="color:#fff" href="/contact-us/#book">Book Appointment</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <Breadcrumbs crumbs={crumbs} />
      <Content />
    </div>
  </section>
  {relatedVideos.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>{vs.treatmentH2}</h2>
        <VideoStrip videos={relatedVideos} />
      </div>
    </section>
  )}
  <section class="section soft">
    <div class="container prose">
      <FaqSection faqs={entry.data.faqs} heading="FAQs" />
    </div>
  </section>
  <CtaBand heading="Talk to our specialists" text="Call us or book an appointment for a personal consultation." />
</BaseLayout>
