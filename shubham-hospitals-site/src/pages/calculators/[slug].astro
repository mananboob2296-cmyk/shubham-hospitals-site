---
import CalcPage from '../../components/calculators/CalcPage.astro';
import { calcSlugsFor, type CalcSlug } from '../../i18n/calculators';

// Only the surviving English calculators are built. The three retired slugs are
// 301'd to the tool that absorbed them (public/_redirects) rather than left as
// duplicate engines that could drift out of agreement with the new ones.
export function getStaticPaths() {
  return calcSlugsFor('en').map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props as { slug: CalcSlug };
---
<CalcPage lang="en" slug={slug} />
