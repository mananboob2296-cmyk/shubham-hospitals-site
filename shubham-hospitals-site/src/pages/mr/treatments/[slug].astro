---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FaqSection from '../../../components/FaqSection.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { deptContent } from '../../../i18n/pages';
import { procContent } from '../../../i18n/procedures';
import VideoStrip from '../../../components/VideoStrip.astro';
import { latest } from '../../../lib/videos';
import { videoStrings } from '../../../i18n/videos';
import { useTranslations } from '../../../i18n/utils';

const lang = 'mr';

export async function getStaticPaths() {
  const treatments = await getCollection('treatments');
  return treatments
    .filter((t) => t.slug.startsWith('mr/'))
    .map((t) => ({ params: { slug: t.slug.replace(/^mr\//, '') }, props: { entry: t } }));
}

const { entry } = Astro.props;
const e = entry.data;
const { Content } = await entry.render();
const t = useTranslations(lang);
const dept = deptContent[lang];
const vs = videoStrings['mr'];
const relatedVideos = entry.slug.replace(/^mr\//, '') === 'advanced-laparoscopy-hysteroscopy' ? latest('drManan', 3) : [];

// Procedure pages sit under /mr/procedures/, not /mr/departments/ — the collection
// is shared, so the parent is decided by `kind` (see src/i18n/procedures.ts).
const p = procContent[lang];
const isProcedure = e.kind === 'procedure';
const eyebrow = isProcedure ? p.singleEyebrow : dept.h1;
const parent = isProcedure
  ? { label: p.crumbProcedures, href: '/mr/procedures/' }
  : { label: dept.h1, href: '/mr/departments/' };
const crumbs = [{ label: t('nav.home'), href: '/mr/' }, parent, { label: e.title }];
---
<BaseLayout title={e.metaTitle} description={e.metaDescription} lang={lang}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{e.title}</h1>
      <p>{e.excerpt}</p>
      <div class="btn-row">
        <a class="btn btn-primary" style="color:#fff" href="/mr/contact-us/#book">{t('cta.book')}</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <Breadcrumbs crumbs={crumbs} />
      <Content />
    </div>
  </section>
  {relatedVideos.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>{vs.treatmentH2}</h2>
        <VideoStrip videos={relatedVideos} />
      </div>
    </section>
  )}
  <section class="section soft">
    <div class="container prose">
      <FaqSection faqs={e.faqs} heading={t('faq.heading')} />
    </div>
  </section>
  <CtaBand />
</BaseLayout>
