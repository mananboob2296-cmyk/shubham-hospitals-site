---
// Shared client-side runtime for every calculator: date helpers, formatting and
// the result-row renderer. Deliberately `is:inline` (not a bundled module) so it
// re-executes after an Astro view transition, exactly like the nav/loader scripts
// in BaseLayout. Everything runs in the visitor's browser — no data leaves the page.
import { calcShared } from '../../i18n/calculators';
import type { Lang } from '../../i18n/ui';
import { localeCodes } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = calcShared(lang);
const locale = localeCodes[lang];
const units = s.units;
const errors = s.errors;
const resultUi = s.resultUi ?? null;
const trimesters = s.trimesters;
---
<script is:inline define:vars={{ locale, units, trimesters, errors, resultUi }}>
  window.SHC = (function () {
    var MS = 86400000;

    /** Parse a yyyy-mm-dd input value into a local Date pinned to midday.
     *  Midday avoids every daylight-saving and timezone off-by-one. */
    function parse(v) {
      if (!v) return null;
      var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(v);
      if (!m) return null;
      var dt = new Date(+m[1], +m[2] - 1, +m[3], 12, 0, 0, 0);
      return isNaN(dt.getTime()) ? null : dt;
    }

    /** Parse a datetime-local value (yyyy-mm-ddThh:mm) keeping the time. */
    function parseDT(v) {
      if (!v) return null;
      var dt = new Date(v);
      return isNaN(dt.getTime()) ? null : dt;
    }

    function addDays(d, n) {
      var out = new Date(d.getTime());
      out.setDate(out.getDate() + n);
      return out;
    }

    function today() {
      var n = new Date();
      return new Date(n.getFullYear(), n.getMonth(), n.getDate(), 12, 0, 0, 0);
    }

    /** Whole days from a to b (b later => positive). */
    function diffDays(a, b) {
      return Math.round((b.getTime() - a.getTime()) / MS);
    }

    /** Today as yyyy-mm-dd, for pinning `max` on a historical date input.
     *  Computed in the browser, never at build time, so it never goes stale. */
    function todayISO() {
      var n = new Date();
      var m = String(n.getMonth() + 1).padStart(2, '0');
      var d = String(n.getDate()).padStart(2, '0');
      return n.getFullYear() + '-' + m + '-' + d;
    }

    /** True when d is after today. Used to reject a date for an event that is
     *  said to have already happened — a typo'd year must not return an estimate
     *  that looks like a normal current pregnancy. */
    function isFuture(d) {
      return !!d && diffDays(today(), d) > 0;
    }

    /** Cap a date input at today and keep that cap correct across midnight. */
    function capToday(input) {
      if (!input) return;
      input.setAttribute('max', todayISO());
    }

    var dateFmt = new Intl.DateTimeFormat(locale, { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
    var shortFmt = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric' });
    var timeFmt = new Intl.DateTimeFormat(locale, { hour: 'numeric', minute: '2-digit' });

    function fmt(d) { return d ? dateFmt.format(d) : ''; }
    function fmtShort(d) { return d ? shortFmt.format(d) : ''; }
    function fmtTime(d) { return d ? timeFmt.format(d) : ''; }
    function range(a, b) { return fmtShort(a) + ' ' + units.to + ' ' + fmtShort(b); }

    /** "{w} weeks {d} days" in the active language. */
    function weeksDays(totalDays) {
      var w = Math.floor(totalDays / 7);
      var d = totalDays % 7;
      return units.weeksDays.replace('{w}', w).replace('{d}', d);
    }

    /** 0 = first trimester, 1 = second, 2 = third. */
    function trimester(totalDays) {
      if (totalDays < 98) return trimesters[0];   // < 14w0d
      if (totalDays < 196) return trimesters[1];  // < 28w0d
      return trimesters[2];
    }

    function num(v, dp) {
      var n = parseFloat(v);
      if (!isFinite(n)) return null;
      return dp === undefined ? n : Math.round(n * Math.pow(10, dp)) / Math.pow(10, dp);
    }

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    /** Render result rows. Each row = { k: label, v: value, note?: string, big?: true }.
     *  Passing null/undefined resets the panel to its empty state. */
    function render(root, rows) {
      var box = root.querySelector('[data-calc-rows]');
      if (!box) return;
      if (!rows || !rows.length) {
        box.innerHTML = '<p class="calc-empty">' + esc(box.getAttribute('data-empty') || '') + '</p>';
        return;
      }
      box.innerHTML = rows
        .map(function (r) {
          if (r.list) {
            return '<div class="calc-row calc-row-list"><span class="calc-k">' + esc(r.k) + '</span><ul class="calc-list">' +
              r.list.map(function (li) { return '<li>' + esc(li) + '</li>'; }).join('') + '</ul></div>';
          }
          return '<div class="calc-row' + (r.big ? ' calc-row-big' : '') + '">' +
            '<span class="calc-k">' + esc(r.k) + '</span>' +
            '<span class="calc-v">' + esc(r.v) + '</span>' +
            (r.note ? '<span class="calc-note">' + esc(r.note) + '</span>' : '') +
            '</div>';
        })
        .join('');
    }

    /** Show a validation message under `input` and clear the result panel, so a
     *  rejected value never leaves a stale estimate looking like a current one. */
    function fieldError(root, input, message) {
      clearErrors(root);
      var field = input && input.closest ? input.closest('.calc-field') : null;
      if (field) {
        field.classList.add('calc-field-invalid');
        var p = document.createElement('p');
        p.className = 'calc-err';
        p.id = (input.id || 'calc') + '-err';
        p.textContent = message;
        field.appendChild(p);
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-describedby', p.id);
      }
      var box = root.querySelector('[data-calc-rows]');
      if (box) box.innerHTML = '<p class="calc-err">' + esc(message) + '</p>';
    }

    /** Remove every validation message and invalid marker from the form. */
    function clearErrors(root) {
      root.querySelectorAll('.calc-field-invalid').forEach(function (f) {
        f.classList.remove('calc-field-invalid');
      });
      root.querySelectorAll('.calc-form .calc-err').forEach(function (e) { e.remove(); });
      root.querySelectorAll('[aria-invalid]').forEach(function (i) {
        i.removeAttribute('aria-invalid');
        i.removeAttribute('aria-describedby');
      });
    }

    /** Reject a historical date that sits in the future. Returns true when the
     *  value is unusable, having already reported it to the visitor. */
    function rejectFuture(root, input) {
      var d = parse(input.value);
      if (!isFuture(d)) return false;
      fieldError(root, input, errors.futureDate);
      return true;
    }

    /** Read an allowlisted ?param= value. Anything unrecognised falls back to
     *  the default: the query may pick a starting state, never carry data into
     *  the page. Method and view names only — never a date, weight or result. */
    function queryChoice(param, allowed, fallback) {
      try {
        var v = new URLSearchParams(window.location.search).get(param);
        return allowed.indexOf(v) >= 0 ? v : fallback;
      } catch (e) {
        return fallback;
      }
    }

    /** Supporting lines under the result: the method used, the as-of date, the
     *  limitation that applies, and one next step. */
    function renderMeta(root, meta) {
      var box = root.querySelector('[data-calc-meta]');
      if (!box) return;
      if (!meta || !resultUi) { box.innerHTML = ''; return; }
      var parts = [];
      function row(label, value) {
        if (!value) return;
        parts.push('<div class="calc-meta-row"><span class="calc-meta-k">' + esc(label) +
          '</span><span class="calc-meta-v">' + esc(value) + '</span></div>');
      }
      row(resultUi.method, meta.method);
      row(resultUi.asOf, meta.asOf);
      row(resultUi.limitation, meta.limitation);
      row(resultUi.nextStep, meta.nextStep);
      box.innerHTML = parts.join('');
    }

    /** Mark an existing result as out of date the moment an input changes, and
     *  block copying until it is recalculated. A stale estimate shown as a
     *  current one is the failure mode worth designing against here. */
    function setStale(root, stale) {
      var banner = root.querySelector('[data-calc-stale]');
      var copyBtn = root.querySelector('[data-calc-copy]');
      var hasResult = !!root.querySelector('[data-calc-rows] .calc-row');
      var on = !!stale && hasResult;
      if (banner) {
        banner.hidden = !on;
        if (on && resultUi) banner.textContent = resultUi.stale;
      }
      if (copyBtn) copyBtn.disabled = on || !hasResult;
      var panel = root.querySelector('.calc-out');
      if (panel) panel.classList.toggle('calc-out-stale', on);
    }

    /** Clear the result panel completely: rows, meta and the stale banner. */
    function resetResult(root) {
      render(root, null);
      renderMeta(root, null);
      setStale(root, false);
    }

    /** Wire a user-initiated Copy summary. Never writes to the clipboard on its
     *  own, and never includes a name or any identifier — just the numbers the
     *  visitor already entered and the answer shown on screen. */
    function wireCopy(root, buildText) {
      var btn = root.querySelector('[data-calc-copy]');
      if (!btn || !resultUi) return;
      btn.addEventListener('click', function () {
        var text = buildText();
        if (!text) return;
        var done = function () {
          var was = btn.textContent;
          btn.textContent = resultUi.copied;
          setTimeout(function () { btn.textContent = was; }, 1600);
        };
        try {
          navigator.clipboard.writeText(text).then(done, function () {});
        } catch (e) {}
      });
    }

    /** Turn the rendered rows into plain text for Copy summary. */
    function summaryText(root, heading) {
      var out = heading ? [heading] : [];
      root.querySelectorAll('[data-calc-rows] .calc-row').forEach(function (r) {
        var k = r.querySelector('.calc-k'), v = r.querySelector('.calc-v');
        if (k && v) out.push(k.textContent + ': ' + v.textContent);
      });
      root.querySelectorAll('[data-calc-meta] .calc-meta-row').forEach(function (r) {
        out.push(r.querySelector('.calc-meta-k').textContent + ': ' + r.querySelector('.calc-meta-v').textContent);
      });
      return out.join('\n');
    }

    /** Wire up a calculator: runs now and after every view transition, once per element. */
    function boot(name, setup) {
      function init() {
        var root = document.querySelector('[data-calc="' + name + '"]');
        if (!root || root.dataset.ready === '1') return;
        root.dataset.ready = '1';
        setup(root);
      }
      init();
      if (!window.__calcBound) {
        window.__calcBound = {};
      }
      if (!window.__calcBound[name]) {
        window.__calcBound[name] = 1;
        document.addEventListener('astro:page-load', init);
      }
    }

    return {
      parse: parse, parseDT: parseDT, addDays: addDays, today: today, diffDays: diffDays,
      fmt: fmt, fmtShort: fmtShort, fmtTime: fmtTime, range: range,
      weeksDays: weeksDays, trimester: trimester, num: num, esc: esc,
      render: render, boot: boot, units: units, MS: MS,
      todayISO: todayISO, isFuture: isFuture, capToday: capToday,
      queryChoice: queryChoice, renderMeta: renderMeta, setStale: setStale,
      resetResult: resetResult, wireCopy: wireCopy, summaryText: summaryText,
      resultUi: resultUi,
      fieldError: fieldError, clearErrors: clearErrors, rejectFuture: rejectFuture,
      errors: errors,
    };
  })();
</script>
