---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../CtaBand.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CalcIcon from './CalcIcon.astro';
import { allCalculators, calcShared, calcPath, calcCopy, enHubGroups } from '../../i18n/calculators';
import type { Lang } from '../../i18n/ui';
import { SITE } from '../../consts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = calcShared(lang);
const home = lang === 'en' ? '/' : `/${lang}/`;

// English shows the four consolidated tools, grouped by the question being
// asked. Four tools need no search box, filter chips or role gate. Hindi and
// Marathi keep the original eight-card grid until they are consolidated too.
const consolidated = lang === 'en' && !!s.hub;
const groupLabel: Record<string, string> = s.hub
  ? { pregnancy: s.hub.groupPregnancy, cycle: s.hub.groupCycle, lab: s.hub.groupLab }
  : {};
const cards = consolidated
  ? enHubGroups.map((c) => ({
      slug: c.slug,
      icon: c.icon,
      copy: calcCopy(lang, c.slug),
      href: c.href ?? calcPath(lang, c.slug),
      group: groupLabel[c.group],
    }))
  : allCalculators(lang).map((i) => ({
      slug: i.slug,
      icon: i.icon,
      copy: i.copy,
      href: calcPath(lang, i.slug),
      group: undefined as string | undefined,
    }));
const items = cards;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: s.hubH1,
    description: s.hubMetaDescription,
    url: new URL(calcPath(lang), SITE.url).href,
    inLanguage: lang,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    hasPart: items.map((i) => ({
      '@type': 'WebApplication',
      name: i.copy.name,
      description: i.copy.card,
      url: new URL(calcPath(lang, i.slug), SITE.url).href,
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    })),
  },
];
---
<BaseLayout title={s.hubMetaTitle} description={s.hubMetaDescription} schema={schema} lang={lang}>
  <section class="hero calc-hero">
    <div class="container">
      <Breadcrumbs crumbs={[{ label: s.crumbHome, href: home }, { label: s.crumbCalculators }]} />
      <span class="eyebrow">{s.hubEyebrow}</span>
      <h1>{s.hubH1}</h1>
      <p>{s.hubLead}</p>
    </div>
  </section>

  <section class="section calc-section">
    <div class="container">
      {consolidated && s.hub && <p class="calc-method-note">{s.hub.methodNote}</p>}

      <div class:list={['grid', consolidated ? 'calc-cards-4' : 'cols-3', 'calc-cards']}>
        {items.map((i) => (
          <article class="card calc-card">
            <CalcIcon name={i.icon} />
            {i.group && <span class="calc-group">{i.group}</span>}
            <h2><a class="calc-card-link" href={i.href}>{i.copy.name}</a></h2>
            <p>{i.copy.card}</p>
            {i.copy.audience && <span class="calc-audience">{i.copy.audience}</span>}
          </article>
        ))}
      </div>

      {consolidated && s.hub && (
        <aside class="calc-info">
          <h2>{s.hub.infoH}</h2>
          <p>{s.hub.infoLead}</p>
          <a class="more" href={calcPath(lang, 'kick-counter')}>{s.hub.infoLink} →</a>
        </aside>
      )}

      <aside class="calc-disclaimer">
        <h2>{s.disclaimerH}</h2>
        <p>{s.disclaimer}</p>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
