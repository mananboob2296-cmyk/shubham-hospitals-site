---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../CtaBand.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CalcIcon from './CalcIcon.astro';
import CalcRuntime from './CalcRuntime.astro';
import Ovulation from './Ovulation.astro';
import DueDate from './DueDate.astro';
import IvfDueDate from './IvfDueDate.astro';
import Period from './Period.astro';
import PregnancyWeek from './PregnancyWeek.astro';
import WeightGain from './WeightGain.astro';
import HcgDoubling from './HcgDoubling.astro';
import KickCounter from './KickCounter.astro';
import PregnancyDating from './PregnancyDating.astro';
import CycleCalculator from './CycleCalculator.astro';
import { calcCopy, calcShared, calcPath, relatedCalculators, legacyEnRoutes, enDestination, type CalcSlug } from '../../i18n/calculators';
import type { Lang } from '../../i18n/ui';
import { SITE } from '../../consts';

interface Props { lang: Lang; slug: CalcSlug }
const { lang, slug } = Astro.props;
const s = calcShared(lang);
const copy = calcCopy(lang, slug);
const related = relatedCalculators(lang, slug);
const home = lang === 'en' ? '/' : `/${lang}/`;
const contact = lang === 'en' ? '/contact-us/' : `/${lang}/contact-us/`;
const url = new URL(calcPath(lang, slug), SITE.url).href;

// Hindi and Marathi still run the original one-method-per-page components:
// consolidating them means merging their clinical copy, which needs a reviewer
// rather than a translation guess. English gets the consolidated engines.
const components: Record<CalcSlug, any> = {
  'ovulation-calculator': Ovulation,
  'pregnancy-due-date-calculator': DueDate,
  'ivf-due-date-calculator': IvfDueDate,
  'period-calculator': Period,
  'pregnancy-week-calculator': PregnancyWeek,
  'pregnancy-weight-gain-calculator': WeightGain,
  'hcg-doubling-calculator': HcgDoubling,
  'kick-counter': KickCounter,
};
const enComponents: Partial<Record<CalcSlug, any>> = {
  'pregnancy-due-date-calculator': PregnancyDating,
  'ovulation-calculator': CycleCalculator,
};
const Calculator = (lang === 'en' && enComponents[slug]) || components[slug];

// A hi/mr page whose English counterpart was consolidated away must not claim
// an English URL that now 301s. Point its English alternate at the surviving
// page instead, so hreflang resolves in one hop to a real document.
const moved = lang !== 'en' && legacyEnRoutes[slug];
const altPaths = moved
  ? { en: enDestination(slug), [lang]: calcPath(lang, slug) }
  : undefined;

// An urgent help block is lifted out of the editorial run and rendered directly
// beneath the calculator, with a telephone action. Someone reading "call straight
// away" should not have to scroll past two explainer sections to find a number,
// and must not be handed a routine booking link as the only thing to click.
const urgent = copy.helpUrgent ? copy.help : null;
const blocks = urgent ? [copy.howTo, copy.limits] : [copy.howTo, copy.limits, copy.help];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    name: copy.h1,
    description: copy.metaDescription,
    url,
    inLanguage: lang,
    about: { '@type': 'MedicalCondition', name: copy.eyebrow },
    publisher: { '@type': 'MedicalClinic', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: copy.name,
    description: copy.card,
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': 'MedicalClinic', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout title={copy.metaTitle} description={copy.metaDescription} schema={schema} lang={lang} altPaths={altPaths}>
  <section class="hero calc-hero">
    <div class="container">
      <Breadcrumbs
        crumbs={[
          { label: s.crumbHome, href: home },
          { label: s.crumbCalculators, href: calcPath(lang) },
          { label: copy.name },
        ]}
      />
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.h1}</h1>
      <p>{copy.lead}</p>
    </div>
  </section>

  <section class="section calc-section">
    <div class="container">
      <CalcRuntime lang={lang} />
      <Calculator copy={copy} shared={s} lang={lang} />

      {urgent && (
        <aside class="calc-urgent" role="note">
          <h2>{urgent.h}</h2>
          {Array.isArray(urgent.body)
            ? urgent.body.map((line) => <p>{line}</p>)
            : <p>{urgent.body}</p>}
          <a class="calc-call" href={SITE.phoneHref}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2a1 1 0 011-.24 11.4 11.4 0 003.6.58 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.4 11.4 0 00.58 3.6 1 1 0 01-.25 1z"/></svg>
            {s.callNow} — {SITE.phone}
          </a>
        </aside>
      )}
    </div>
  </section>

  <section class="section soft">
    <div class="container calc-editorial">
      {blocks.map((b) => (
        <div class="calc-block">
          <h2>{b.h}</h2>
          {Array.isArray(b.body) ? <ul>{b.body.map((li) => <li>{li}</li>)}</ul> : <p>{b.body}</p>}
        </div>
      ))}
      {copy.clinical && (
        <details class="calc-clinical">
          <summary>{s.resultUi?.clinicalH ?? copy.clinical.h}</summary>
          {Array.isArray(copy.clinical.body)
            ? <ul>{copy.clinical.body.map((li) => <li>{li}</li>)}</ul>
            : <p>{copy.clinical.body}</p>}
        </details>
      )}
      <div class="calc-block">
        <a class="btn btn-primary" href={contact + '#book'}>{s.bookCta}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container calc-editorial">
      <h2>{s.faqH}</h2>
      <div class="faq-page">
        {copy.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <aside class="calc-disclaimer">
        <h2>{s.disclaimerH}</h2>
        <p>{s.disclaimer}</p>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
  <section class="section soft">
    <div class="container">
      <h2>{s.relatedH}</h2>
      <div class:list={['grid', related.length > 2 ? 'cols-3' : 'cols-2', 'calc-cards']}>
        {related.map((r) => (
          <article class="card calc-card">
            <CalcIcon name={r.icon} />
            <h3>{r.copy.name}</h3>
            <p>{r.copy.card}</p>
            <a class="more" href={calcPath(lang, r.slug)}>{s.open} →</a>
          </article>
        ))}
      </div>
      <p class="calc-all"><a class="more" href={calcPath(lang)}>{s.allCalculators} →</a></p>
    </div>
  </section>
  )}

  <CtaBand />
</BaseLayout>
