---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../CtaBand.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CalcIcon from './CalcIcon.astro';
import CalcRuntime from './CalcRuntime.astro';
import UrgentPanel from './UrgentPanel.astro';
import IvfDueDate from './IvfDueDate.astro';
import Period from './Period.astro';
import PregnancyWeek from './PregnancyWeek.astro';
import WeightGain from './WeightGain.astro';
import HcgDoubling from './HcgDoubling.astro';
import KickCounter from './KickCounter.astro';
import PregnancyDating from './PregnancyDating.astro';
import CycleCalculator from './CycleCalculator.astro';
import { calcCopy, calcShared, calcPath, relatedCalculators, urgentHelp, urgentHelpFirst, type CalcSlug } from '../../i18n/calculators';
import type { Lang } from '../../i18n/ui';
import { SITE } from '../../consts';

interface Props { lang: Lang; slug: CalcSlug }
const { lang, slug } = Astro.props;
const s = calcShared(lang);
const copy = calcCopy(lang, slug);
const related = relatedCalculators(lang, slug);
const home = lang === 'en' ? '/' : `/${lang}/`;
const contact = lang === 'en' ? '/contact-us/' : `/${lang}/contact-us/`;
const url = new URL(calcPath(lang, slug), SITE.url).href;

// Every language runs the consolidated engines. The one-method-per-page
// components remain only for the retired slugs, which are no longer built as
// pages but still exist in each pack because the type requires all eight keys.
const components: Record<CalcSlug, any> = {
  'ovulation-calculator': CycleCalculator,
  'pregnancy-due-date-calculator': PregnancyDating,
  'ivf-due-date-calculator': IvfDueDate,
  'period-calculator': Period,
  'pregnancy-week-calculator': PregnancyWeek,
  'pregnancy-weight-gain-calculator': WeightGain,
  'hcg-doubling-calculator': HcgDoubling,
  'kick-counter': KickCounter,
};
const Calculator = components[slug];

// An urgent help block is lifted out of the editorial run and rendered as a
// panel with a telephone action, beside the tool rather than below three
// sections of explanation. Someone reading "call straight away" should not have
// to scroll to find a number, and must not be handed a routine booking link as
// the only thing to click. `urgentHelpFirst` puts it above the tool where the
// tool itself could delay the call.
const urgent = urgentHelp.includes(slug) ? copy.help : null;
const urgentFirst = urgentHelpFirst.includes(slug);
const blocks = urgent ? [copy.howTo, copy.limits] : [copy.howTo, copy.limits, copy.help];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    name: copy.h1,
    description: copy.metaDescription,
    url,
    inLanguage: lang,
    about: { '@type': 'MedicalCondition', name: copy.eyebrow },
    publisher: { '@type': 'MedicalClinic', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: copy.name,
    description: copy.card,
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': 'MedicalClinic', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout title={copy.metaTitle} description={copy.metaDescription} schema={schema} lang={lang}>
  <section class="hero calc-hero">
    <div class="container">
      <Breadcrumbs
        crumbs={[
          { label: s.crumbHome, href: home },
          { label: s.crumbCalculators, href: calcPath(lang) },
          { label: copy.name },
        ]}
      />
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.h1}</h1>
      <p>{copy.lead}</p>
    </div>
  </section>

  <section class="section calc-section">
    <div class="container">
      <CalcRuntime lang={lang} />

      {urgent && urgentFirst && <UrgentPanel block={urgent} shared={s} />}
      <Calculator copy={copy} shared={s} lang={lang} />

      {urgent && !urgentFirst && <UrgentPanel block={urgent} shared={s} />}
    </div>
  </section>

  <section class="section soft">
    <div class="container calc-editorial">
      {blocks.map((b) => (
        <div class="calc-block">
          <h2>{b.h}</h2>
          {Array.isArray(b.body) ? <ul>{b.body.map((li) => <li>{li}</li>)}</ul> : <p>{b.body}</p>}
        </div>
      ))}
      {copy.clinical && (
        <details class="calc-clinical">
          <summary>{s.resultUi?.clinicalH ?? copy.clinical.h}</summary>
          {Array.isArray(copy.clinical.body)
            ? <ul>{copy.clinical.body.map((li) => <li>{li}</li>)}</ul>
            : <p>{copy.clinical.body}</p>}
        </details>
      )}
      <div class="calc-block">
        <a class="btn btn-primary" href={contact + '#book'}>{s.bookCta}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container calc-editorial">
      <h2>{s.faqH}</h2>
      <div class="faq-page">
        {copy.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <aside class="calc-disclaimer">
        <h2>{s.disclaimerH}</h2>
        <p>{s.disclaimer}</p>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
  <section class="section soft">
    <div class="container">
      <h2>{s.relatedH}</h2>
      <div class:list={['grid', related.length === 1 ? 'calc-cards-one' : 'cols-2', 'calc-cards']}>
        {related.map((r) => (
          <article class="card calc-card">
            <CalcIcon name={r.icon} />
            <h3>{r.copy.name}</h3>
            <p>{r.copy.card}</p>
            <a class="more" href={calcPath(lang, r.slug)}>{s.open} →</a>
          </article>
        ))}
      </div>
      <p class="calc-all"><a class="more" href={calcPath(lang)}>{s.allCalculators} →</a></p>
    </div>
  </section>
  )}

  <CtaBand />
</BaseLayout>
